# Add or remove environment variables here.
CONTACT_EMAIL='CONTACT_EMAIL'
CONTACT_PHONE='CONTACT_PHONE'
DEPARTMENT_NAME='Legal Aid Agency'
DEPARTMENT_URL='DEPARTMENT_URL'
RATELIMIT_HEADERS_ENABLED=True
RATELIMIT_STORAGE_URI='DATA_BASE_URL'
RATE_LIMIT_MAX=100
RATE_WINDOW_MS=900000 # 15 * 60 * 1000 = 900000
SERVICE_NAME='Assess and refer for civil legal advice'
SERVICE_PHASE='Beta'
SERVICE_URL='SERVICE_URL'
NODE_ENV=development
SESSION_SECRET='s3Cur3'
SESSION_NAME='sessionId'
TEST_ACCESS_TOKEN='test-access-token'

# Microsoft Entra / SiLAS authentication (required - app fails to start without these)
ENTRA_AUTHORITY='https://login.microsoftonline.com/<tenant-id>'
ENTRA_TENANT_ID='<tenant-id>'
ENTRA_CLIENT_ID='<client-id>'
ENTRA_CLIENT_SECRET='<client-secret>'
ENTRA_REDIRECT_URI='http://localhost:3000/redirect'
ENTRA_POST_REDIRECT_URI='/'
ENTRA_SCOPES='openid,profile,email'
ENTRA_EXPECTED_AUDIENCE='<expected-audience>'

# Redis Configuration (for session storage in multi-pod deployments)
REDIS_ENABLED=false
REDIS_HOST='localhost'
REDIS_PORT=6379
REDIS_TLS_ENABLED=false
