{% extends "base.njk" %}

{% block content %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-three-quarters">
            <h1 class="govuk-heading-xl">Enter client’s address</h1>
            <h3 class="govuk-heading-s">Enter address manually</h3>
            
            {% if fieldValidationErrors | length %}
                {{ govukErrorSummary({
                    titleText: "There is a problem",
                    errorList: fieldValidationErrors
                }) }}
            {% endif %}

            <form method="post" novalidate>
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">

                {% for block in blocks %}
                    {{ block | safe }}
                {% endfor %}
            </form>
        </div>
    </div>
    
    <p class="govuk-body">
  <a href="#" class="govuk-link">Search for an address </a>
</p>
{% endblock %}
