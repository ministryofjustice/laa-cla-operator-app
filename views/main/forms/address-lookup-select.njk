{% extends "base.njk" %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block content %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-three-quarters">
            {% if data.lookup.error !== null %}
                <div class="govuk-error-summary" role="alert">
                <div class="govuk-error-summary__body">
                    <p class="govuk-body">
                        Address lookup is temporarily unavailable. Please try again later.
                        <p class="govuk-body-s"><a href="{{ forgeReverse('case.add-address', {':caseId': data.case.reference}) }}">Enter address manually</a></p>
                    </p>
                </div>
                </div>
            {% endif %}

            {% if data.lookup.count == 0 %}
            <h1 class="govuk-heading-xl">Address not found</h1>
            <h3 class="govuk-heading-m">No address found</h3>
            {% if data.lookup.postcode and data.lookup.building %}
            <p class="govuk-body-s">We could not find an address that matches <b>{{ data.lookup.postcode}}</b> and <b>{{ data.lookup.building}}</b>. You can search again or enter the address manually.</p>
            {% endif %}
            <p class="govuk-body-s"><a href="{{forgeReverse('case.address-lookup', {':caseId': data.case.reference}) }}">Search again</a></p>
            <p class="govuk-body-s"><a href="{{ forgeReverse('case.add-address', {':caseId': data.case.reference}) }}">Enter address manually</a></p>
            {% else %}
            <h1 class="govuk-heading-xl">{{ step.title }}</h1>
            {% if fieldValidationErrors | length %}
                {{ govukErrorSummary({
                    titleText: "There is a problem",
                    errorList: fieldValidationErrors
                }) }}
            {% endif %}

            <form method="post" novalidate>
                <h2 class="govuk-heading-m">Select an address</h2>
                <p class="govuk-body-s">
                {{ data.lookup.count }} addresses found for <b>{{ data.lookup.postcode}}</b> and <b>{{ data.lookup.building}}</b>.
                <a href="{{forgeReverse('case.address-lookup', {':caseId': data.case.reference}) }}">Search again</a>
                </p>
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">

                {% for block in blocks %}
                    {{ block | safe }}
                {% endfor %}
            </form>

            <p class='govuk-body'><h3 class='govuk-heading-m'>Address not found</h3></p>
            <p class='govuk-body-s'>If your address was not found, try a different search or enter the address manually <a href='{{ forgeReverse('case.address-lookup', {':caseId': data.case.reference}) }}' class='govuk-link govuk-link--no-underline'>Enter address manually</a></p>,

            {% endif %}

        </div>
    </div>
{% endblock %}
