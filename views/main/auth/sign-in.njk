{% extends "base.njk" %}

{% block pageTitle %}{% if errors and errors.length %}Error: {% endif %}Assess and refer for civil legal advice{% endblock %}

{% block content %}

  {% if errors and errors.length %}
    <div class="govuk-error-summary two-thirds-login" data-module="govuk-error-summary">
      <div role="alert">
        <h2 class="govuk-error-summary__title">
          There is a problem
        </h2>
        <div class="govuk-error-summary__body">
          <ul class="govuk-list govuk-error-summary__list">
            {% for error in errors %}
              <li>{{ error.text }}</li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  {% endif %}

  <h1 class="govuk-heading-l">Assess and refer for civil legal advice</h1>

  <a href="/login" role="button" draggable="false" class="govuk-button govuk-button--start" data-module="govuk-button">
    Sign in
  </a>

{% endblock %}