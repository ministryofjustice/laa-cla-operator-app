{# Reuse the shared GOV.UK page wrapper (head, assets, base structure). #}
{% extends "partials/layout.njk" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {# Forge provides fieldValidationErrors when submit validation fails. #}
      {% if fieldValidationErrors | length %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: fieldValidationErrors
        }) }}
      {% endif %}

      {# POSTs back to the current step route; Forge handles submit/redirect logic. #}
      <form method="post" novalidate>
        {# CSRF token supplied by Forge adapter for form protection. #}
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">

        {# Render all step blocks generated by the journey definition. #}
        {% for block in blocks %}
          {{ block | safe }}
        {% endfor %}
      </form>
    </div>
  </div>
{% endblock %}