{
  "reporter": [
    "text",
    "lcov",
    "html"
  ],
  "include": [
    "src/**/*.ts",
    "routes/**/*.ts",
    "middleware/**/*.ts",
    "utils/**/*.ts"
  ],
  "exclude": [
    "playwright.config.ts",
    "test",
    "tests",
    "**/*.d.ts",
    "**/*.test.ts",
    "src/scripts/custom.ts",
    "src/scripts/frontendPackagesEntry.ts",
    "src/scripts/helpers/index.ts",
    "src/scripts/pages/yourCases.ts",
    "middleware/index.ts",
    "middleware/setupCsrf.ts",
    "utils/helmetSetup.ts",
    "utils/rateLimitSetUp.ts",
    "utils/index.ts",
    "utils/axiosSetup.ts",
    "utils/nunjucksSetup.ts",
    "src/app.ts",
    "routes/index.ts",
    "src/controllers/**",
    "src/journeys/**",
    "src/middleware/apiMiddleware.ts",
    "src/services/exampleApiService.ts",
    "src/middlewares/personSchema.ts",
    "utils/displayAsciiBanner.ts",
    "src/services/baseApiService.ts",
    "src/scripts/helpers/i18nLoader.ts",
    "src/helpers/ValidationErrorHelpers.ts",
    "src/helpers/dataTransformers.ts",
    "src/scripts/helpers/dataTransformers.ts",
    "src/scripts/helpers/errorHandler.ts"
  ],
  "all": true,
  "sourceMap": true,
  "check-coverage": true,
  "lines": 100,
  "functions": 100,
  "branches": 100,
  "statements": 100
}